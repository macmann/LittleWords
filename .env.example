DATABASE_URL=
STORAGE_PROVIDER=local
TTS_PROVIDER=none
# Choose your parent password in the app on first launch, not in this file.
# Set a random string (at least 32 characters) in production.
PARENT_SESSION_SECRET=
# Hosting: absolute directory on a persistent disk/volume; unset keeps the dev path.
UPLOAD_DIR=
# Optional canonical public origin, e.g. https://words.example.com (no path).
APP_ORIGIN=
# Render supplies PORT automatically; Coolify should set PORT=3000.
# PORT=3000
