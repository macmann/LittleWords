DATABASE_URL=
STORAGE_PROVIDER=local
TTS_PROVIDER=none
# Each family chooses an account password during signup, not in this file.
# Set a random string (at least 32 characters) in production.
PARENT_SESSION_SECRET=
# Hosting: absolute directory on a persistent disk/volume; unset uses private var/uploads in development.
UPLOAD_DIR=
# Optional canonical public origin, e.g. https://words.example.com (no path).
APP_ORIGIN=
# Render supplies PORT automatically; Coolify should set PORT=3000.
# PORT=3000
# Optional AI adventure planning. Never prefix these keys with NEXT_PUBLIC_.
# Enable it separately in Parent area; curated adventures work without a key.
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
